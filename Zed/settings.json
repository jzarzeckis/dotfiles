// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "edit_predictions": {
    "provider": "zed",
  },
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "cursor_animation": {
    "enabled": true
  },
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right",
  },
  "markdown_preview": {
    "open_markdown_files_in_preview": true,
  },
  "code_lens": "on",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]"
      },
      "type": "registry",
    },
  },
  "language_models": {
    "openai_compatible": {},
  },
  "minimap": {
    "show": "always",
    "current_line_highlight": "all",
  },
  "context_servers": {
    "Chrome Devtools": {
      "enabled": false,
      "remote": false,
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
    },
    "Playwright": {
      "enabled": false,
      "remote": false,
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "agent": {
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gemini-3-flash",
        "enable_thinking": true,
        "effort": "HIGH"
      }
    ],
    "play_sound_when_agent_done": "always",
    "dock": "left",
    "show_turn_stats": true,
    "profiles": {
      "pdb": {
        "default_model": {
          "provider": "zed.dev",
          "model": "gemini-3.5-flash",
          "enable_thinking": true,
          "effort": "MEDIUM",
        },
        "name": "pdb",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "update_plan": true,
          "search_web": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {},
      },
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^bun\\s+run(\\s|$)"
            },
            {
              "pattern": "^bun\\b"
            }
          ],
          "always_deny": [
            {
              "pattern": "^git",
            },
          ],
        },
      },
      "default": "confirm",
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
    },
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 12,
  "buffer_font_family": "Fira Code",
  "theme": {
    "mode": "light",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "terminal": {
    "font_family": ".ZedMono",
    "font_size": 12,
    "line_height": "standard",
  },
  "show_edit_predictions": true,
  "inlay_hints": { "enabled": true },
  "indent_guides": {
    "enabled": true,
    "background_coloring": "indent_aware",
    "coloring": "indent_aware",
  },
  "calls": {
    "mute_on_join": true,
  },
  "languages": {
    "Python": {
      "enable_language_server": false,
    },
  },
}
